import React, { useState, useEffect } from 'react';
import { Search, BookOpen, Star, Download, Filter, Moon, Sun, Heart, TrendingUp, Menu, X, User, Bell, Share2, Eye } from 'lucide-react';

export default function EnhancedBookStore() {
  const [isDark, setIsDark] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedClass, setSelectedClass] = useState('all');
  const [selectedSubject, setSelectedSubject] = useState('all');
  const [favorites, setFavorites] = useState([]);
  const [showMobileMenu, setShowMobileMenu] = useState(false);
  const [showFilters, setShowFilters] = useState(false);

  // Sample books data
  const books = [
    {
      id: 1,
      title: "Brahmastra Booklet",
      class: "X",
      subject: "All Subjects",
      author: "Next Toppers",
      edition: "2025-2026",
      cover: "https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=300&h=400&fit=crop",
      rating: 4.8,
      downloads: 1234,
      pages: 250,
      size: "15 MB",
      featured: true
    },
    {
      id: 2,
      title: "RD Sharma Mathematics",
      class: "X",
      subject: "Mathematics",
      author: "RD Sharma",
      edition: "2023-2024",
      cover: "https://images.unsplash.com/photo-1509228468518-180dd4864904?w=300&h=400&fit=crop",
      rating: 4.6,
      downloads: 2156,
      pages: 450,
      size: "25 MB",
      featured: true
    },
    {
      id: 3,
      title: "NCERT Science",
      class: "X",
      subject: "Science",
      author: "NCERT",
      edition: "2024-2025",
      cover: "https://images.unsplash.com/photo-1532012197267-da84d127e765?w=300&h=400&fit=crop",
      rating: 4.9,
      downloads: 3421,
      pages: 320,
      size: "20 MB",
      featured: true
    },
    {
      id: 4,
      title: "English Literature",
      class: "X",
      subject: "English",
      author: "CBSE",
      edition: "2024-2025",
      cover: "https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=300&h=400&fit=crop",
      rating: 4.7,
      downloads: 1876,
      pages: 280,
      size: "18 MB",
      featured: false
    },
    {
      id: 5,
      title: "Social Studies",
      class: "X",
      subject: "Social Science",
      author: "NCERT",
      edition: "2024-2025",
      cover: "https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=300&h=400&fit=crop",
      rating: 4.5,
      downloads: 1543,
      pages: 300,
      size: "22 MB",
      featured: false
    },
    {
      id: 6,
      title: "Oswaal Sample Papers",
      class: "X",
      subject: "All Subjects",
      author: "Oswaal",
      edition: "2024-2025",
      cover: "https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?w=300&h=400&fit=crop",
      rating: 4.8,
      downloads: 2987,
      pages: 200,
      size: "12 MB",
      featured: true
    }
  ];

  const classes = ['all', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
  const subjects = ['all', 'Mathematics', 'Science', 'English', 'Social Science', 'All Subjects'];

  const filteredBooks = books.filter(book => {
    const matchesSearch = book.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
                         book.author.toLowerCase().includes(searchQuery.toLowerCase());
    const matchesClass = selectedClass === 'all' || book.class === selectedClass;
    const matchesSubject = selectedSubject === 'all' || book.subject === selectedSubject;
    return matchesSearch && matchesClass && matchesSubject;
  });

  const featuredBooks = books.filter(book => book.featured);

  const toggleFavorite = (bookId) => {
    setFavorites(prev => 
      prev.includes(bookId) 
        ? prev.filter(id => id !== bookId)
        : [...prev, bookId]
    );
  };

  const BookCard = ({ book, featured = false }) => (
    <div className={`${isDark ? 'bg-gray-800' : 'bg-white'} rounded-xl shadow-lg overflow-hidden transform transition-all duration-300 hover:scale-105 hover:shadow-2xl ${featured ? 'border-2 border-yellow-400' : ''}`}>
      <div className="relative">
        <img src={book.cover} alt={book.title} className="w-full h-64 object-cover" />
        {featured && (
          <div className="absolute top-2 left-2 bg-yellow-400 text-black px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1">
            <Star size={14} fill="currentColor" /> Featured
          </div>
        )}
        <button
          onClick={() => toggleFavorite(book.id)}
          className={`absolute top-2 right-2 p-2 rounded-full ${favorites.includes(book.id) ? 'bg-red-500' : 'bg-white/80'} backdrop-blur-sm transition-all`}
        >
          <Heart size={20} fill={favorites.includes(book.id) ? 'white' : 'none'} className={favorites.includes(book.id) ? 'text-white' : 'text-red-500'} />
        </button>
      </div>
      <div className="p-4">
        <h3 className={`font-bold text-lg mb-2 ${isDark ? 'text-white' : 'text-gray-800'}`}>{book.title}</h3>
        <p className={`text-sm mb-2 ${isDark ? 'text-gray-400' : 'text-gray-600'}`}>
          Class {book.class} • {book.subject}
        </p>
        <p className={`text-xs mb-3 ${isDark ? 'text-gray-500' : 'text-gray-500'}`}>
          by {book.author} • {book.edition}
        </p>
        
        <div className="flex items-center gap-4 mb-3 text-sm">
          <div className="flex items-center gap-1">
            <Star size={16} fill="#fbbf24" className="text-yellow-400" />
            <span className={isDark ? 'text-gray-300' : 'text-gray-700'}>{book.rating}</span>
          </div>
          <div className="flex items-center gap-1">
            <Download size={16} className={isDark ? 'text-gray-400' : 'text-gray-600'} />
            <span className={isDark ? 'text-gray-300' : 'text-gray-700'}>{book.downloads}</span>
          </div>
          <div className={`text-xs ${isDark ? 'text-gray-400' : 'text-gray-600'}`}>
            {book.pages} pages • {book.size}
          </div>
        </div>

        <div className="flex gap-2">
          <button className="flex-1 bg-gradient-to-r from-blue-500 to-blue-600 text-white py-2 px-4 rounded-lg hover:from-blue-600 hover:to-blue-700 transition-all flex items-center justify-center gap-2">
            <Eye size={18} /> Preview
          </button>
          <button className="flex-1 bg-gradient-to-r from-green-500 to-green-600 text-white py-2 px-4 rounded-lg hover:from-green-600 hover:to-green-700 transition-all flex items-center justify-center gap-2">
            <Download size={18} /> Download
          </button>
        </div>
      </div>
    </div>
  );

  return (
    <div className={`min-h-screen ${isDark ? 'bg-gray-900' : 'bg-gradient-to-br from-blue-50 via-purple-50 to-pink-50'} transition-colors duration-300`}>
      {/* Header */}
      <header className={`${isDark ? 'bg-gray-800 border-gray-700' : 'bg-white/80'} backdrop-blur-md sticky top-0 z-50 border-b shadow-lg`}>
        <div className="max-w-7xl mx-auto px-4 py-4">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-3">
              <BookOpen className={`${isDark ? 'text-blue-400' : 'text-blue-600'}`} size={32} />
              <h1 className={`text-2xl font-bold ${isDark ? 'text-white' : 'text-gray-800'}`}>
                <span className="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">Book</span>Store
              </h1>
            </div>

            <div className="hidden md:flex items-center gap-4">
              <button className={`p-2 rounded-lg ${isDark ? 'hover:bg-gray-700' : 'hover:bg-gray-100'} transition-colors`}>
                <Bell size={22} className={isDark ? 'text-gray-300' : 'text-gray-700'} />
              </button>
              <button 
                onClick={() => setIsDark(!isDark)}
                className={`p-2 rounded-lg ${isDark ? 'hover:bg-gray-700 bg-gray-700' : 'hover:bg-gray-100'} transition-colors`}
              >
                {isDark ? <Sun size={22} className="text-yellow-400" /> : <Moon size={22} className="text-gray-700" />}
              </button>
              <button className={`p-2 rounded-lg ${isDark ? 'hover:bg-gray-700' : 'hover:bg-gray-100'} transition-colors`}>
                <User size={22} className={isDark ? 'text-gray-300' : 'text-gray-700'} />
              </button>
            </div>

            <button 
              onClick={() => setShowMobileMenu(!showMobileMenu)}
              className="md:hidden p-2 rounded-lg"
            >
              {showMobileMenu ? <X size={24} /> : <Menu size={24} />}
            </button>
          </div>
        </div>
      </header>

      {/* Hero Section */}
      <div className={`${isDark ? 'bg-gradient-to-r from-gray-800 to-gray-900' : 'bg-gradient-to-r from-blue-600 to-purple-600'} text-white py-16`}>
        <div className="max-w-7xl mx-auto px-4 text-center">
          <h2 className="text-4xl md:text-5xl font-bold mb-4">Your Study Partner 📚</h2>
          <p className="text-xl mb-8 opacity-90">Free Books, PDFs, Sample Papers & More!</p>
          
          {/* Search Bar */}
          <div className="max-w-3xl mx-auto">
            <div className={`${isDark ? 'bg-gray-800' : 'bg-white'} rounded-full shadow-2xl p-2 flex items-center gap-2`}>
              <Search className={`${isDark ? 'text-gray-400' : 'text-gray-500'} ml-4`} size={24} />
              <input
                type="text"
                placeholder="Search books, authors, subjects..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className={`flex-1 px-4 py-3 ${isDark ? 'bg-gray-800 text-white' : 'bg-transparent text-gray-800'} outline-none text-lg`}
              />
              <button 
                onClick={() => setShowFilters(!showFilters)}
                className={`${isDark ? 'bg-gray-700 hover:bg-gray-600' : 'bg-blue-600 hover:bg-blue-700'} text-white px-6 py-3 rounded-full transition-all flex items-center gap-2`}
              >
                <Filter size={20} /> Filters
              </button>
            </div>
          </div>
        </div>
      </div>

      {/* Filters */}
      {showFilters && (
        <div className={`${isDark ? 'bg-gray-800' : 'bg-white'} shadow-lg`}>
          <div className="max-w-7xl mx-auto px-4 py-6">
            <div className="grid md:grid-cols-2 gap-4">
              <div>
                <label className={`block text-sm font-medium mb-2 ${isDark ? 'text-gray-300' : 'text-gray-700'}`}>Class</label>
                <select
                  value={selectedClass}
                  onChange={(e) => setSelectedClass(e.target.value)}
                  className={`w-full px-4 py-2 rounded-lg border ${isDark ? 'bg-gray-700 border-gray-600 text-white' : 'bg-white border-gray-300'} outline-none focus:ring-2 focus:ring-blue-500`}
                >
                  {classes.map(cls => (
                    <option key={cls} value={cls}>{cls === 'all' ? 'All Classes' : `Class ${cls}`}</option>
                  ))}
                </select>
              </div>
              <div>
                <label className={`block text-sm font-medium mb-2 ${isDark ? 'text-gray-300' : 'text-gray-700'}`}>Subject</label>
                <select
                  value={selectedSubject}
                  onChange={(e) => setSelectedSubject(e.target.value)}
                  className={`w-full px-4 py-2 rounded-lg border ${isDark ? 'bg-gray-700 border-gray-600 text-white' : 'bg-white border-gray-300'} outline-none focus:ring-2 focus:ring-blue-500`}
                >
                  {subjects.map(sub => (
                    <option key={sub} value={sub}>{sub === 'all' ? 'All Subjects' : sub}</option>
                  ))}
                </select>
              </div>
            </div>
          </div>
        </div>
      )}

      <div className="max-w-7xl mx-auto px-4 py-12">
        {/* Featured Books */}
        <div className="mb-12">
          <div className="flex items-center gap-2 mb-6">
            <TrendingUp className={isDark ? 'text-yellow-400' : 'text-yellow-600'} size={28} />
            <h2 className={`text-3xl font-bold ${isDark ? 'text-white' : 'text-gray-800'}`}>Featured Books</h2>
          </div>
          <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {featuredBooks.map(book => (
              <BookCard key={book.id} book={book} featured={true} />
            ))}
          </div>
        </div>

        {/* All Books */}
        <div>
          <h2 className={`text-3xl font-bold mb-6 ${isDark ? 'text-white' : 'text-gray-800'}`}>
            All Books ({filteredBooks.length})
          </h2>
          {filteredBooks.length > 0 ? (
            <div className="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
              {filteredBooks.map(book => (
                <BookCard key={book.id} book={book} />
              ))}
            </div>
          ) : (
            <div className={`text-center py-12 ${isDark ? 'text-gray-400' : 'text-gray-600'}`}>
              <BookOpen size={64} className="mx-auto mb-4 opacity-50" />
              <p className="text-xl">No books found matching your criteria</p>
            </div>
          )}
        </div>
      </div>

      {/* Footer */}
      <footer className={`${isDark ? 'bg-gray-800 border-gray-700' : 'bg-white'} border-t mt-12`}>
        <div className="max-w-7xl mx-auto px-4 py-8">
          <div className="grid md:grid-cols-3 gap-8">
            <div>
              <h3 className={`font-bold text-lg mb-3 ${isDark ? 'text-white' : 'text-gray-800'}`}>About BookStore</h3>
              <p className={`text-sm ${isDark ? 'text-gray-400' : 'text-gray-600'}`}>
                Your one-stop destination for free educational resources, PDFs, and study materials.
              </p>
            </div>
            <div>
              <h3 className={`font-bold text-lg mb-3 ${isDark ? 'text-white' : 'text-gray-800'}`}>Quick Links</h3>
              <ul className={`space-y-2 text-sm ${isDark ? 'text-gray-400' : 'text-gray-600'}`}>
                <li><a href="#" className="hover:text-blue-600">Privacy Policy</a></li>
                <li><a href="#" className="hover:text-blue-600">Terms of Service</a></li>
                <li><a href="#" className="hover:text-blue-600">Contact Us</a></li>
              </ul>
            </div>
            <div>
              <h3 className={`font-bold text-lg mb-3 ${isDark ? 'text-white' : 'text-gray-800'}`}>Follow Us</h3>
              <div className="flex gap-3">
                <button className="p-2 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full text-white hover:scale-110 transition-transform">
                  <Share2 size={20} />
                </button>
              </div>
            </div>
          </div>
          <div className={`text-center mt-8 pt-8 border-t ${isDark ? 'border-gray-700 text-gray-400' : 'border-gray-200 text-gray-600'} text-sm`}>
